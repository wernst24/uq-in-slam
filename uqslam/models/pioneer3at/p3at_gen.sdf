      <!-- Joints -->
      <joint name="robot1_p3at_front_left_wheel_joint" type="revolute">
        <pose relative_to="robot1_base_link">0.135 0.197 0.111 0 -0 0</pose>
        <parent>robot1_base_link</parent>
        <child>robot1_p3at_front_left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <effort>100</effort>
            <velocity>100</velocity>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
