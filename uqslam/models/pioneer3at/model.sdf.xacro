              </contact>
              <friction>
                <ode>
                  <mu>10</mu>
                  <mu2>1</mu2>
                  <fdir1>0 1 0</fdir1>
                </ode>
              </friction>
            </surface>
          </collision>
          <visual name='${prefix}p3at_back_right_wheel_visual'>
            <pose>0 0 0 0 -0 0</pose>
            <geometry>
              <mesh>
                <scale>1 1 1</scale>
                <uri>model://pioneer3at/meshes/wheel.stl</uri>
              </mesh>
            </geometry>
            <material>
              <script>
                <name>Gazebo/Black</name>
                <uri>file://media/materials/scripts/gazebo.material</uri>
              </script>
            </material>
            <visible>${visible}</visible>
          </visual>
        </link>


        <!-- ========== Diff Drive Plugin ========== -->
        <plugin name='${prefix}diff_drive' filename='libgazebo_ros_diff_drive.so'>
          <ros>
            <namespace>${namespace}</namespace>
            <remapping>cmd_vel:=cmd_vel</remapping>
            <remapping>odom:=odom</remapping>
          </ros>
          <num_wheel_pairs>2</num_wheel_pairs>
          <left_joint>${prefix}p3at_front_left_wheel_joint</left_joint>
          <right_joint>${prefix}p3at_front_right_wheel_joint</right_joint>
          <left_joint>${prefix}p3at_back_left_wheel_joint</left_joint>
          <right_joint>${prefix}p3at_back_right_wheel_joint</right_joint>
          <wheel_separation>0.4</wheel_separation>
          <wheel_diameter>0.215</wheel_diameter>
          <max_wheel_torque>200</max_wheel_torque>
          <max_wheel_acceleration>1.0</max_wheel_acceleration>
          <publish_odom>true</publish_odom>
          <publish_odom_tf>true</publish_odom_tf>
          <publish_wheel_tf>true</publish_wheel_tf>
          <odometry_frame>${prefix}odom</odometry_frame>
          <robot_base_frame>${prefix}base_link</robot_base_frame>
        </plugin>

        <!-- ========== Laser Link and Plugin ========== -->
        <link name="${prefix}laser_link">
          <inertial>
            <mass>0.1</mass>
          </inertial>
          <pose>0.15 0 0.30 0 0 0</pose>
          <visual name="${prefix}laser_visual">
            <geometry>
              <mesh>
                <uri>model://hokuyo/meshes/hokuyo.dae</uri>
              </mesh>
            </geometry>
            <visible>${visible}</visible>
          </visual>
          <collision name="${prefix}laser_collision-base">
            <pose>0 0 -0.0145 0 0 0</pose>
            <geometry>
              <box>
                <size>0.05 0.05 0.041</size>
              </box>
            </geometry>
            <surface>
              <contact>
                <collide_bitmask>${collide_bitmask}</collide_bitmask>
                <ode />
              </contact>
            </surface>
          </collision>
          <collision name="${prefix}laser_collision-top">
            <pose>0 0 0.0205 0 0 0</pose>
            <geometry>
              <cylinder>
                <radius>0.021</radius>
                <length>0.029</length>
              </cylinder>
            </geometry>
            <surface>
              <contact>
                <collide_bitmask>${collide_bitmask}</collide_bitmask>
                <ode />
              </contact>
            </surface>
          </collision>
          <sensor name="${prefix}laser" type="ray">
            <pose>0.01 0 0.0175 0 -0 0</pose>
            <ray>
              <scan>
                <horizontal>
                  <samples>5</samples>
                  <resolution>1</resolution>
                  <min_angle>-2.35619</min_angle>
                  <max_angle>2.35619</max_angle>
                </horizontal>
              </scan>
              <range>
                <min>0.08</min>
                <max>10</max>
                <resolution>0.05</resolution>
              </range>
            </ray>
            <always_on>1</always_on>
            <update_rate>5</update_rate>
            <visualize>true</visualize>
            <plugin name='${prefix}laser_plugin' filename='libgazebo_ros_ray_sensor.so'>
              <ros>
                <namespace>${namespace}</namespace>
                <argument>--ros-args --remap ~/out:=scan</argument>
              </ros>
              <output_type>sensor_msgs/LaserScan</output_type>
            </plugin>
          </sensor>
        </link>
        <joint type="fixed" name="${prefix}laser_joint">
          <child>${prefix}laser_link</child>
          <parent>${prefix}base_link</parent>
        </joint>

        <!-- ========== Camera Link and Plugin ========== -->
        <link name="${prefix}camera_link">
          <inertial>
            <mass>0.1</mass>
          </inertial>
          <pose>0.15 0 0.40 0 0 0</pose>
          <sensor name="${prefix}my_camera" type="camera">
            <camera>
              <horizontal_fov>1.047</horizontal_fov>
              <image>
                <width>32</width>
                <height>32</height>
              </image>
              <clip>
                <near>0.1</near>
                <far>20</far>
              </clip>
            </camera>
            <always_on>1</always_on>
            <update_rate>5</update_rate>
            <plugin name="${prefix}ros_camera_plugin" filename="libgazebo_ros_camera.so">
              <ros>
                <namespace>${namespace}</namespace>
                <remapping>image_raw:=camera/image_raw</remapping>
                <remapping>camera_info:=camera/camera_info</remapping>
              </ros>
              <camera_name>${prefix}my_camera</camera_name>
              <frame_name>${prefix}camera_link</frame_name>
            </plugin>
          </sensor>
        </link>
        <joint type="fixed" name="${prefix}camera_joint">
          <child>${prefix}camera_link</child>
          <parent>${prefix}base_link</parent>
        </joint>

        <!-- ========== Additional visuals, collisions, joints, and frames ========== -->
        <!-- Copy and prefix all other links, joints, visuals, collisions, and frames from model.sdf
        as needed -->
        <frame name='${prefix}base_back_joint' attached_to='${prefix}base_link'>
          <pose>-0.187 0 0.247 0 -0 0</pose>
        </frame>
        <frame name='${prefix}back_sonar' attached_to='${prefix}base_back_joint' />
        <frame name='${prefix}base_front_joint' attached_to='${prefix}base_link'>
          <pose>0.193 0 0.25 0 -0 0</pose>
        </frame>
        <frame name='${prefix}front_sonar' attached_to='${prefix}base_front_joint' />
        <frame name='${prefix}base_front_left_hub_joint' attached_to='${prefix}p3at_front_left_axle'>
          <pose>0 0.041 0 0 -0 0</pose>
        </frame>
        <frame name='${prefix}p3at_front_left_hub' attached_to='${prefix}base_front_left_hub_joint' />
        <frame name='${prefix}base_front_left_axle_joint' attached_to='${prefix}base_link'>
          <pose>0.135 0.156 0.111 0 -0 0</pose>
        </frame>
        <frame name='${prefix}p3at_front_left_axle' attached_to='${prefix}base_front_left_axle_joint' />
        <frame name='${prefix}base_front_right_hub_joint' attached_to='${prefix}p3at_front_right_axle'>
          <pose>0 -0.041 0 0 -0 0</pose>
        </frame>
        <frame name='${prefix}p3at_front_right_hub' attached_to='${prefix}base_front_right_hub_joint' />
        <frame name='${prefix}base_front_right_axle_joint' attached_to='${prefix}base_link'>
          <pose>0.135 -0.156 0.111 0 -0 0</pose>
        </frame>
        <frame name='${prefix}p3at_front_right_axle' attached_to='${prefix}base_front_right_axle_joint' />
        <frame name='${prefix}base_top_joint' attached_to='${prefix}base_link'>
          <pose>0.003 0 0.274 0 -0 0</pose>
        </frame>
        <frame name='${prefix}top_plate' attached_to='${prefix}base_top_joint' />
        <frame name='${prefix}p3at_back_left_hub_joint' attached_to='${prefix}p3at_back_left_axle'>
          <pose>-0 0.041 0 0 -0 0</pose>
        </frame>
        <frame name='${prefix}p3at_back_left_hub' attached_to='${prefix}p3at_back_left_hub_joint' />
        <frame name='${prefix}bp3at_back_left_axle_joint' attached_to='${prefix}base_link'>
          <pose>-0.134 0.156 0.111 0 -0 0</pose>
        </frame>
        <frame name='${prefix}p3at_back_left_axle' attached_to='${prefix}bp3at_back_left_axle_joint' />
        <frame name='${prefix}p3at_back_right_hub_joint' attached_to='${prefix}p3at_back_right_axle'>
          <pose>-0 -0.041 0 0 -0 0</pose>
        </frame>
        <frame name='${prefix}p3at_back_right_hub' attached_to='${prefix}p3at_back_right_hub_joint' />
        <static>0</static>
        <frame name='${prefix}bp3at_back_right_axle_joint' attached_to='${prefix}base_link'>
          <pose>-0.134 -0.156 0.111 0 -0 0</pose>
        </frame>
        <frame name='${prefix}p3at_back_right_axle' attached_to='${prefix}bp3at_back_right_axle_joint' />

        <static>0</static>
      </model>
    </sdf>
  </xacro:macro>
</robot>