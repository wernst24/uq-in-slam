<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:sdf="http://sdformat.org/schemas/sdf/1.7">

  <!-- ===== Xacro Macro Header ===== -->
  <xacro:macro name="pioneer3at" params="prefix namespace collide_bitmask visible">

    <sdf version='1.7'>
      <model name='${prefix}pioneer3at'>

        <!-- ========== Base Link ========== -->
        <link name='${prefix}base_link'>
          <inertial>
            <pose>-0.000108 0 0.172396 0 -0 0</pose>
            <mass>11.1</mass>
            <inertia>
              <ixx>11.3649</ixx>
              <ixy>0</ixy>
              <ixz>-0.000345176</ixz>
              <iyy>11.5059</iyy>
              <iyz>0</iyz>
              <izz>11.3808</izz>
            </inertia>
          </inertial>

          <!-- Collisions -->
          <collision name='${prefix}base_link_collision'>
            <pose>0 0 0.177 0 -0 0</pose>
            <geometry>
              <mesh>
                <scale>1 1 1</scale>
                <uri>model://pioneer3at/meshes/chassis.stl</uri>
              </mesh>
            </geometry>
            <surface>
              <contact>
                <collide_bitmask>${collide_bitmask}</collide_bitmask>
                <ode />
              </contact>
              <friction>
                <ode />
              </friction>
            </surface>
          </collision>

          <collision name='${prefix}base_link_fixed_joint_lump__back_sonar_collision_1'>
